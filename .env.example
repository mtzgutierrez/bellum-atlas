# ============================================
# CONFIGURATION EXAMPLE - Docker Compose
# ============================================
# Copy this file to .env and fill in with your values

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
BUILD_TARGET=development
COMPOSE_PROJECT_NAME=bellum_atlas


# ============================================
# POSTGRESQL
# ============================================
POSTGRES_DB=nombre_de_tu_base_de_datos
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ============================================
# BACKEND
# ============================================
BACKEND_PORT=3000
BACKEND_DEBUG_PORT=9229

# ============================================
# REDIS (caché + colas BullMQ para la IA)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# IA / LLM
# ============================================
# Proveedor del LLM usado SOLO por los workers en background (nunca en una
# request del usuario). Valores:
#   mock      → genera una plantilla local, sin coste ni red (por defecto).
#   anthropic → llama a Claude. Requiere ANTHROPIC_API_KEY.
AI_PROVIDER=mock

# API key de Anthropic. Sólo se usa si AI_PROVIDER=anthropic.
# Consíguela en https://console.anthropic.com/ (formato sk-ant-...).
ANTHROPIC_API_KEY=

# Modelo de Claude a usar. Recomendado: claude-sonnet-4-6 (rápido y económico)
# o claude-opus-4-8 (máxima calidad).
AI_MODEL=claude-sonnet-4-6

# El seed/ingesta pre-genera la IA de las batallas con importanceScore mayor
# que este umbral (0-100).
AI_AUTO_QUEUE_MIN_SCORE=80
# Búsqueda web de Claude para enriquecer las narrativas (true|false)
AI_WEB_SEARCH=true

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# ============================================
# LOGS
# ============================================
LOG_LEVEL=debugs
# Generación de IA a demanda del usuario (true|false).
AI_ON_DEMAND=false

# Job diario de enriquecimiento (nº batallas/día a búsqueda web) + cron.
AI_DAILY_WEB_BUDGET=15
AI_DAILY_CRON=0 3 * * *
