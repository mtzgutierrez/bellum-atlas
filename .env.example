# ============================================
# CONFIGURATION EXAMPLE - Docker Compose
# ============================================
# Copy this file to .env and fill in with your values

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
BUILD_TARGET=development
COMPOSE_PROJECT_NAME=ares_codex_app


# ============================================
# POSTGRESQL
# ============================================
POSTGRES_DB=nombre_de_tu_base_de_datos
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ============================================
# BACKEND
# ============================================
BACKEND_PORT=3000
BACKEND_DEBUG_PORT=9229

JWT_SECRET=genera_un_secreto_aleatorio_aqui
JWT_EXPIRATION=7d

# Clave compartida entre backend y scraper para proteger los endpoints internos
SCRAPER_API_KEY=cambia_esto_por_una_clave_secreta

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# ============================================
# LOGS
# ============================================
LOG_LEVEL=debugs