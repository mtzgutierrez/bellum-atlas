{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": false,
    "assets": [
      {
        "include": "**/*.hbs",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  },
  "watchOptions": {
    "usePolling": true,
    "interval": 1000
  }
}
