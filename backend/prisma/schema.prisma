generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum BattleType {
  LAND
  NAVAL
  AIR
  SIEGE
  COMBINED
}

// ─── CORE ENTITIES ────────────────────────────────────────────────────────────

/// Períodos históricos. Seed fijo: Antigüedad, Edad Media, Era Moderna, Contemporánea, S. XX, S. XXI
model HistoricalEra {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      // orden cronológico para el UI
  wars      War[]
  battles   Battle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("historical_eras")
}

/// Punto geográfico. lat/lon en WGS84 decimal.
/// La columna PostGIS GEOMETRY(Point,4326) se añade en la migración raw:
///   ALTER TABLE locations ADD COLUMN geom geometry(Point,4326)
///     GENERATED ALWAYS AS (ST_SetSRID(ST_MakePoint(lon, lat), 4326)) STORED;
model Location {
  id      String  @id @default(cuid())
  name    String
  country String?
  lat     Float
  lon     Float
  battles Battle[]
  wars    War[]

  @@map("locations")
}

model War {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  result       String?        // texto libre: "Victoria aliada", "Inconcluso"...
  imageUrl     String?
  wikipediaUrl String?        @unique
  eraId        String?
  era          HistoricalEra? @relation(fields: [eraId], references: [id])
  locationId   String?
  location     Location?      @relation(fields: [locationId], references: [id])
  battles      BattleWar[]
  factions     WarFaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("wars")
}

model Battle {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String?
  date         DateTime?
  dateText     String?         // texto raw de Wikipedia antes de parsear
  result       String?
  type         BattleType?
  imageUrl     String?
  wikipediaUrl String?         @unique
  eraId        String?
  era          HistoricalEra?  @relation(fields: [eraId], references: [id])
  locationId   String?
  location     Location?       @relation(fields: [locationId], references: [id])
  wars         BattleWar[]
  factions     BattleFaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("battles")
}

// ─── RELACIÓN MUCHOS A MUCHOS: Battle ↔ War ───────────────────────────────────

model BattleWar {
  battleId String
  warId    String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  war      War    @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@id([battleId, warId])
  @@map("battle_wars")
}

// ─── FACCIONES ────────────────────────────────────────────────────────────────

/// Cada bando de una batalla (máx. 2 por batalla: side 1 y side 2).
/// Captura beligerantes, bajas y resultado por bando, tal como aparecen en la infobox de Wikipedia.
model BattleFaction {
  id            String                   @id @default(cuid())
  side          Int                      // 1 o 2
  belligerents  String?                  // texto raw: "Francia | Guardia Imperial"
  result        String?                  // "victory" | "defeat" | "draw" | "inconclusive"
  strengthRaw   String?                  // texto raw de efectivos
  casualtiesRaw String?                  // texto raw: "40.000–45.000"
  casualtiesMin Int?
  casualtiesMax Int?
  battleId      String
  battle        Battle                   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  commanders    CommanderBattleFaction[]

  @@unique([battleId, side])
  @@map("battle_factions")
}

/// Cada bando de una guerra (máx. 2 por guerra).
model WarFaction {
  id           String                @id @default(cuid())
  side         Int                   // 1 o 2
  belligerents String?
  result       String?
  warId        String
  war          War                   @relation(fields: [warId], references: [id], onDelete: Cascade)
  commanders   CommanderWarFaction[]

  @@unique([warId, side])
  @@map("war_factions")
}

// ─── COMANDANTES ──────────────────────────────────────────────────────────────

model Commander {
  id           String                   @id @default(cuid())
  name         String
  country      String?
  birthYear    Int?
  deathYear    Int?
  description  String?
  imageUrl     String?
  wikipediaUrl String?                  @unique
  battles      CommanderBattleFaction[]
  wars         CommanderWarFaction[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@map("commanders")
}

// ─── JOIN: Commander ↔ BattleFaction ──────────────────────────────────────────

/// Un comandante puede estar en varios bandos (de distintas batallas).
/// Un bando puede tener varios comandantes.
model CommanderBattleFaction {
  commanderId     String
  battleFactionId String
  commander       Commander     @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  battleFaction   BattleFaction @relation(fields: [battleFactionId], references: [id], onDelete: Cascade)

  @@id([commanderId, battleFactionId])
  @@map("commander_battle_factions")
}

// ─── JOIN: Commander ↔ WarFaction ─────────────────────────────────────────────

model CommanderWarFaction {
  commanderId  String
  warFactionId String
  commander    Commander  @relation(fields: [commanderId], references: [id], onDelete: Cascade)
  warFaction   WarFaction @relation(fields: [warFactionId], references: [id], onDelete: Cascade)

  @@id([commanderId, warFactionId])
  @@map("commander_war_factions")
}
