generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// MODELO DE DATOS – HISTORICAL ATLAS
// =============================================================================
// Diseño intencionadamente simple. Sólo Battle / War / Commander y relaciones
// directas. Las fechas son años (Int) para alimentar el timeline. La IA queda
// pre-computada en BattleAISummary; nunca se invoca síncronamente en una
// request del usuario.
// =============================================================================

model Battle {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wikidataId      String?    @unique
  name            String
  slug            String     @unique

  // Años (suficiente para timeline; fechas exactas eran ruido).
  year            Int?
  startYear       Int?
  endYear         Int?

  // Geo. Sin PostGIS: bbox queries con índice compuesto (lat, lng).
  latitude        Float?
  longitude       Float?

  // Catalogación ligera.
  imageUrl        String?
  wikipediaUrl    String?
  summary         String?    // extract de Wikipedia, opcional, sirve de seed
                             // para el prompt de IA. No es contenido AI.
  type            BattleType @default(BATTLE)

  // 0-100. Proxy: nº de sitelinks de Wikidata normalizado. Battles con score
  // alto se pre-generan en IA.
  importanceScore Int        @default(0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wars            BattleWar[]
  commanders      BattleCommander[]
  aiSummary       BattleAISummary?

  @@index([year])
  @@index([latitude, longitude])
  @@index([importanceScore])
  @@map("battles")
}

model War {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wikidataId   String?  @unique
  name         String
  slug         String   @unique
  startYear    Int?
  endYear      Int?
  imageUrl     String?
  wikipediaUrl String?
  summary      String?
  region       String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  battles      BattleWar[]

  @@index([startYear])
  @@map("wars")
}

model Commander {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wikidataId   String?  @unique
  name         String
  slug         String   @unique
  birthYear    Int?
  deathYear    Int?
  imageUrl     String?
  wikipediaUrl String?
  summary      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  battles      BattleCommander[]

  @@map("commanders")
}

model BattleWar {
  battleId String @db.Uuid
  warId    String @db.Uuid

  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  war      War    @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@id([battleId, warId])
  @@index([warId])
  @@map("battle_wars")
}

model BattleCommander {
  battleId    String  @db.Uuid
  commanderId String  @db.Uuid
  side        String?       // "Aliados"/"Eje"/"1"/"2"... libre

  battle      Battle    @relation(fields: [battleId],    references: [id], onDelete: Cascade)
  commander   Commander @relation(fields: [commanderId], references: [id], onDelete: Cascade)

  @@id([battleId, commanderId])
  @@index([commanderId])
  @@map("battle_commanders")
}

// ─── CACHÉ PERMANENTE DE IA ────────────────────────────────────────────────
// Una row por batalla. Si no existe, el endpoint devuelve 202 y encola.
// Nunca se invalida automáticamente.
model BattleAISummary {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  battleId    String   @unique @db.Uuid

  summary     String   @db.Text     // narrativa principal (Story Mode)
  context     String   @db.Text     // contexto estratégico
  outcome     String   @db.Text     // resultado y consecuencias
  curiosities String   @db.Text     // anécdotas y datos curiosos

  modelUsed   String                // p.ej. "claude-sonnet-4-6" o "mock"
  promptHash  String                // hash del prompt usado, para auditar

  createdAt   DateTime @default(now())

  battle      Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@map("battle_ai_summaries")
}

enum BattleType {
  BATTLE
  SIEGE
  CAMPAIGN
}
